# Copia este archivo como .env.local y completa con los valores reales.
# Nunca se versionan valores reales.

# URL del proyecto Supabase (local o remoto).
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon o publishable). Es la única que usa el panel:
# todas las operaciones viajan con la sesión del usuario y quedan sujetas a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La service_role NO se usa en apps/admin. Si alguna vez fuera imprescindible,
# debe justificarse, mantenerse solo en servidor y no llevar prefijo NEXT_PUBLIC_.
